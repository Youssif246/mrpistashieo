# Disable automatic trailing slash redirect by mod_dir (prevents 301 redirect errors on directory paths)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Disable directory browsing
Options -Indexes +FollowSymLinks

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. CANONICAL DOMAIN (FORCE WWW) & FORCE HTTPS (Single 301 Redirect)
  # ----------------------------------------------------------------------------
  # Normalization A: HTTP -> HTTPS on canonical domain
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://www.misterpistachio.com/$1 [R=301,L]

  # Normalization B: non-www -> www on canonical domain
  RewriteCond %{HTTP_HOST} ^misterpistachio\.com$ [NC]
  RewriteRule ^(.*)$ https://www.misterpistachio.com/$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 2. ROOT DIRECTORY
  # Redirect root / to default Arabic language (/ar/) with HTTP 301
  # ----------------------------------------------------------------------------
  RewriteRule ^$ /ar/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. LEGACY ROUTE REDIRECTS (Preserve Backwards Compatibility & Search Value)
  # ----------------------------------------------------------------------------
  RewriteRule ^about/?$ https://www.misterpistachio.com/ar/about/ [R=301,L]
  RewriteRule ^services/?$ https://www.misterpistachio.com/ar/services/ [R=301,L]
  RewriteRule ^varieties/?$ https://www.misterpistachio.com/ar/varieties/ [R=301,L]
  RewriteRule ^products/?$ https://www.misterpistachio.com/ar/varieties/ [R=301,L]
  RewriteRule ^ar/products/?$ https://www.misterpistachio.com/ar/varieties/ [R=301,L]
  RewriteRule ^en/products/?$ https://www.misterpistachio.com/en/varieties/ [R=301,L]
  RewriteRule ^ucb1/?$ https://www.misterpistachio.com/ar/ucb1/ [R=301,L]
  RewriteRule ^usb1/?$ https://www.misterpistachio.com/ar/ucb1/ [R=301,L]
  RewriteRule ^ar/usb1/?$ https://www.misterpistachio.com/ar/ucb1/ [R=301,L]
  RewriteRule ^en/usb1/?$ https://www.misterpistachio.com/en/ucb1/ [R=301,L]
  RewriteRule ^rootstock-ucb1/?$ https://www.misterpistachio.com/ar/ucb1/ [R=301,L]
  RewriteRule ^ar/rootstock-ucb1/?$ https://www.misterpistachio.com/ar/ucb1/ [R=301,L]
  RewriteRule ^en/rootstock-ucb1/?$ https://www.misterpistachio.com/en/ucb1/ [R=301,L]
  RewriteRule ^articles/?$ https://www.misterpistachio.com/ar/articles/ [R=301,L]
  RewriteRule ^articles/(.+?)/?$ https://www.misterpistachio.com/ar/articles/$1/ [R=301,L]
  RewriteRule ^contact/?$ https://www.misterpistachio.com/ar/contact/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 4. STATIC DIRECTORY & ROUTE SERVING (Direct 200 OK for Slash & Non-Slash URLs)
  # ----------------------------------------------------------------------------
  # If requested path corresponds to an existing directory containing index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # If requested path without slash corresponds to a directory containing index.html, serve it directly
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # If requested file exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. DIRECTORY INDEX & ERROR DOCUMENTS
# ------------------------------------------------------------------------------
DirectoryIndex index.html 404/index.html

# Real HTTP 404 status returned for non-existent routes (prevents Soft-404 penalty)
ErrorDocument 404 /404/index.html

# ------------------------------------------------------------------------------
# 6. GZIP / DEFLATE COMPRESSION
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ------------------------------------------------------------------------------
# 7. BROWSER CACHING & EXPIRATION (Core Web Vitals Optimization)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration
  ExpiresDefault "access plus 1 month"

  # HTML documents (short cache for freshness)
  ExpiresByType text/html "access plus 1 hour"

  # Sitemaps & robots
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"

  # Media and Images
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # JavaScript & CSS (hashed bundles)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Immutable cache for versioned/hashed assets
  <FilesMatch "\.(js|css|woff2|woff|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Revalidation for HTML
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------------------
# 8. MIME TYPES
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType application/xml .xml
  AddCharset UTF-8 .xml
</IfModule>
