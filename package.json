{
  "name": "project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/post-build.mjs && node scripts/verify-sitemap.mjs && node scripts/verify-all-pages.mjs",
    "build:static": "ng build && node scripts/post-build.mjs && node scripts/verify-sitemap.mjs && node scripts/verify-all-pages.mjs",
    "build:ssr": "ng build --configuration ssr",
    "postbuild": "node scripts/post-build.mjs && node scripts/verify-sitemap.mjs && node scripts/verify-all-pages.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:seo": "node scripts/verify-all-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "generate:card": "node scripts/generate-card-pdf.mjs",
    "serve:ssr:project": "node dist/project/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.3",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
